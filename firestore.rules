rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'CUSTOMER');
    }

    function isSuperAdmin() {
      return signedIn() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
        || getUserRole() in ['SUPER_ADMIN', 'super_admin']
      );
    }

    function isAdmin() {
      return signedIn() && (
        isSuperAdmin()
        || getUserRole() in ['ADMIN', 'admin', 'OPERATIONS_MANAGER', 'operations_manager']
      );
    }

    function isDispatcher() {
      return signedIn() && (
        isAdmin()
        || getUserRole() in ['DISPATCHER', 'dispatcher']
      );
    }

    function isSupport() {
      return signedIn() && (
        isAdmin()
        || getUserRole() in ['SUPPORT', 'support', 'CUSTOMER_SUPPORT', 'customer_support']
      );
    }

    function isCompany() {
      return signedIn() && getUserRole() in ['COMPANY', 'company', 'CORPORATE', 'corporate'];
    }

    function isTechnician() {
      return signedIn() && getUserRole() in ['TECHNICIAN', 'technician', 'tech'];
    }

    function isApprovedTechnician(uid) {
      return isTechnician() && isOwner(uid)
        && exists(/databases/$(database)/documents/technicians/$(uid))
        && get(/databases/$(database)/documents/technicians/$(uid)).data.isApproved == true
        && get(/databases/$(database)/documents/technicians/$(uid)).data.isActive == true
        && get(/databases/$(database)/documents/technicians/$(uid)).data.subscriptionStatus == 'active'
        && get(/databases/$(database)/documents/technicians/$(uid)).data.isSuspended != true
        && get(/databases/$(database)/documents/technicians/$(uid)).data.isLocked != true
        && get(/databases/$(database)/documents/technicians/$(uid)).data.appAccessEnabled != false;
    }

    function assignedToMe() {
      return signedIn() && (
        (resource.data.keys().hasAny(['assignedTechnician']) && resource.data.assignedTechnician == request.auth.uid)
        || (resource.data.keys().hasAny(['assignedTechnicianId']) && resource.data.assignedTechnicianId == request.auth.uid)
        || (resource.data.keys().hasAny(['technicianId']) && resource.data.technicianId == request.auth.uid)
        || (resource.data.keys().hasAny(['techId']) && resource.data.techId == request.auth.uid)
        // Keep the direct membership predicates visible to Firestore's query
        // authorization engine so array-contains assignment feeds are valid.
        || request.auth.uid in resource.data.assignedTechnicians
        || request.auth.uid in resource.data.technicianIds
      );
    }

    function belongsToMe() {
      return signedIn() && (
        (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid)
        || (resource.data.keys().hasAny(['customerId']) && resource.data.customerId == request.auth.uid)
        || (resource.data.keys().hasAny(['customerUid']) && resource.data.customerUid == request.auth.uid)
        || (resource.data.keys().hasAny(['companyId']) && resource.data.companyId == request.auth.uid)
      );
    }

    function newRecordBelongsToMe() {
      return signedIn() && (
        (request.resource.data.keys().hasAny(['userId']) && request.resource.data.userId == request.auth.uid)
        || (request.resource.data.keys().hasAny(['customerId']) && request.resource.data.customerId == request.auth.uid)
        || (request.resource.data.keys().hasAny(['customerUid']) && request.resource.data.customerUid == request.auth.uid)
        || (request.resource.data.keys().hasAny(['companyId']) && request.resource.data.companyId == request.auth.uid)
      );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'technician';
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'full_name', 'name', 'phone', 'profile_photo', 'updatedAt', 'fcmToken', 'fcmTokens'
        ]);
      allow delete: if isAdmin();
    }

    match /technician_requests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending'];
      allow delete: if isAdmin();
    }

    match /technicians/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.isApproved == false
        && request.resource.data.isActive == false
        && request.resource.data.subscriptionStatus == 'inactive'
        && request.resource.data.status in ['pending', 'draft']
      );
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'full_name', 'name', 'phone', 'whatsapp', 'profile_photo', 'language',
          'languages', 'service_areas', 'skills', 'vehicle', 'availability',
          'available', 'isAvailable', 'online', 'isOnline', 'isTrackingActive',
          'notificationsEnabled', 'fcmToken', 'fcmTokens', 'location', 'latitude', 'longitude',
          'locationUpdatedAt', 'batteryLevel', 'networkStatus', 'speed', 'heading',
          'locationPermission', 'lastActive', 'updatedAt',
          'currentJob', 'currentOrder', 'current_job', 'current_order', 'status',
          'activeJob', 'activeOrderId', 'accountType', 'documents', 'experience',
          'experience_main_skill', 'emirate', 'area', 'trade_license_number',
          'owner_name', 'number_of_technicians', 'areas_covered', 'company_name'
        ])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isApproved', 'subscriptionStatus'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in [
            'AVAILABLE', 'available', 'ONLINE', 'online', 'OFFLINE', 'offline',
            'BUSY', 'busy', 'ON_JOB', 'on_job'
          ]);
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isDispatcher() || isSupport() || assignedToMe() || belongsToMe();
      allow create: if isDispatcher() || isSupport() || newRecordBelongsToMe();
      // Technician mutations go through verified Admin SDK endpoints so a
      // client cannot rewrite prices, customer details, or assignments.
      allow update: if isDispatcher() || isSupport();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isDispatcher() || isSupport() || assignedToMe() || belongsToMe();
      allow create: if isDispatcher() || isSupport() || newRecordBelongsToMe();
      allow update: if isDispatcher() || isSupport();
      allow delete: if isAdmin();
    }

    match /parts/{partId} {
      allow read: if signedIn();
      allow update: if isAdmin();
      allow create, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /models/{modelId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /issues/{issueId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /job_history/{entryId} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
          .data.assignedTechnician == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.techId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.uid));
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    match /activation_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isOwner(requestId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'userId', 'status', 'channel', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(requestId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userId', 'status', 'channel', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /password_reset_requests/{requestId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'status', 'source', 'requestedAt', 'updatedAt', 'requestCount'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() <= 320
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'technician_app'
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.requestCount == 1;
      allow update: if isAdmin() || (
        request.resource.data.email == resource.data.email
        && request.resource.data.source == 'technician_app'
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.requestCount == resource.data.requestCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'requestedAt', 'updatedAt', 'requestCount'
        ])
      );
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
